# Copy this file to .env and fill in the values. Never commit .env.
# Where to find each value: SETUP.md, step 3.

# --- Elastic Cloud Hosted deployment ----------------------------------------
# Kibana URL (no trailing slash).
KIBANA_URL=
# Elasticsearch URL (no trailing slash).
ELASTICSEARCH_URL=
# API key created as the admin user (the "encoded" value).
ELASTIC_API_KEY=

# --- Index and embeddings ---------------------------------------------------
INDEX_NAME=albisgrat-knowledge
# Multilingual embedding endpoint for the semantic_text field.
#   .jina-embeddings-v5-text-small         Elastic Inference Service (tested on Elastic Cloud; use this)
#   .multilingual-e5-small-elasticsearch   runs inside the cluster (local stack; weak across languages)
INFERENCE_ID=.jina-embeddings-v5-text-small

# --- The two demo users (choose two passwords, at least 8 characters) --------
COMPLIANCE_OFFICER_PASSWORD=
RELATIONSHIP_MANAGER_PASSWORD=
